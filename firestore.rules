rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all: Deny all unauthenticated or unspecified access
    match /{document=**} {
      allow read, write: if false;
    }

    // App data (masses, songs, sheets): Strictly restricted to authenticated users
    match /app_data/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
